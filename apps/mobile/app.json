{
  "expo": {
    "name": "Streak",
    "slug": "streak",
    "scheme": "streak",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/streak-app-icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.example.streak" },
    "android": {
      "package": "com.example.streak",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/streak-mark.png",
        "monochromeImage": "./assets/images/streak-mark.png"
      }
    },
    "web": { "favicon": "./assets/images/streak-app-icon.png" },
    "plugins": [
      ["expo-router", { "root": "./src/app" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/streak-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#4F46E5"
        }
      ],
      ["expo-sqlite", { "useSQLCipher": true }],
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }],
      "expo-notifications",
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Allow Streak to read your walking distance for the habits you enable.",
          "healthUpdatePermission": false,
          "healthConnectPermissions": ["READ_DISTANCE"]
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
